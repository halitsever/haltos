#!/usr/bin/env bash
# Egress allowlist for the agent user.
#   haltos-agent-net refresh    resolve /etc/haltos/agent-allowlist into the ipsets ufw matches on
#   haltos-agent-net rollback   put the pre-harden ufw rules back (the lockout guard runs this)
set -euo pipefail

ALLOW=/etc/haltos/agent-allowlist
PENDING=/var/lib/haltos/harden-backup/ufw-pending
V4=haltos-agent4
V6=haltos-agent6
DNS=haltos-agent-dns4

log() { printf '[haltos-agent-net] %s\n' "$*"; }

hosts() { sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$ALLOW"; }

# Loopback resolvers are reached over lo, which ufw already accepts.
resolvers() {
    { resolvectl dns 2>/dev/null | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' || true; } | grep -v '^127\.' || true
    grep -E '^nameserver[[:space:]]+([0-9]{1,3}\.){3}[0-9]{1,3}' /etc/resolv.conf 2>/dev/null | awk '{print $2}' | grep -v '^127\.' || true
}

ensure_sets() {
    ipset -exist create "$V4" hash:ip family inet
    ipset -exist create "$V6" hash:ip family inet6
    ipset -exist create "$DNS" hash:ip family inet
}

# Builds a fresh set and swaps it in, so the live set is never half filled.
fill() {
    local set=$1 family=$2 tmp="$1-n$$"
    shift 2
    ipset -exist create "$tmp" hash:ip family "$family"
    ipset flush "$tmp"
    local ip
    for ip in "$@"; do ipset -exist add "$tmp" "$ip"; done
    ipset swap "$tmp" "$set"
    ipset destroy "$tmp"
}

refresh() {
    ensure_sets
    [ -r "$ALLOW" ] || {
        log "no $ALLOW, sets left empty"
        return 0
    }
    local v4=() v6=() h ip
    for h in $(hosts); do
        while read -r ip; do v4+=("$ip"); done < <(getent ahostsv4 "$h" | awk '{print $1}' | sort -u)
        while read -r ip; do v6+=("$ip"); done < <(getent ahostsv6 "$h" | awk '{print $1}' | grep -v '^::ffff:' | sort -u)
    done
    # A resolver hiccup must not empty a working set and cut the agent off.
    if [ ${#v4[@]} -eq 0 ] && [ ${#v6[@]} -eq 0 ]; then
        log "nothing resolved, keeping the current sets"
        return 0
    fi
    fill "$V4" inet "${v4[@]}"
    fill "$V6" inet6 "${v6[@]}"
    mapfile -t dns < <(resolvers | sort -u)
    fill "$DNS" inet "${dns[@]}"
    log "allowlist: ${#v4[@]} IPv4, ${#v6[@]} IPv6, ${#dns[@]} resolvers"
}

rollback() {
    local f
    for f in after.rules after6.rules; do
        [ -f "$PENDING/$f" ] && install -m640 "$PENDING/$f" "/etc/ufw/$f"
    done
    ufw reload >/dev/null
    rm -rf "$PENDING"
    log "firewall change was not confirmed, previous ufw rules restored"
}

# The timer and harden itself can refresh at the same moment.
exec 9>/run/haltos-agent-net.lock
flock -w 60 9 || {
    log "another run holds the lock"
    exit 1
}

case "${1:-}" in
refresh) refresh ;;
ensure) ensure_sets ;;
rollback) rollback ;;
*)
    sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
