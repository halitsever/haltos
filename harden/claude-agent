#!/usr/bin/env bash
# Starts Claude Code as the isolated agent user in the current directory. claudegrid runs it as the pane command.
set -euo pipefail

AREA=/srv/agents
dir=$(pwd -P)
case $dir/ in
"$AREA"/*) ;;
*)
    printf 'claude-agent: %s is outside %s, the agent user cannot see it.\n' "$dir" "$AREA" >&2
    printf 'hint: clone the project under %s, or drop "command" from ~/.config/claudegrid/config.json\n' "$AREA" >&2
    exit 64
    ;;
esac
# No -i: sudo-rs then matches the login shell, not the launcher, against the sudoers rule.
exec sudo -n -u agent -- /usr/local/lib/haltos/agent-launch "$dir" "$@"
