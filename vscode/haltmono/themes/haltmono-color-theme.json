    "tokenColors": [
        {
            "scope": ["comment", "punctuation.definition.comment", "string.comment"],
            "settings": { "foreground": "#71717a", "fontStyle": "italic" }
        },
        {
            "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"],
            "settings": { "foreground": "#c084fc" }
        },
        {
            "scope": ["string", "string.quoted", "string.template", "markup.inline.raw", "markup.fenced_code"],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant", "variable.other.enummember"],
            "settings": { "foreground": "#facc15" }
        },
        {
            "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace", "storage.type.primitive"],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "scope": ["variable", "meta.definition.variable", "variable.other.readwrite"],
            "settings": { "foreground": "#fafafa" }
        },
        {
            "scope": ["variable.parameter", "meta.parameter"],
            "settings": { "foreground": "#d4d4d8" }
        },
        {
            "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.parameter.function.language.special"],
            "settings": { "foreground": "#f87171" }
        },
        {
            "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key"],
            "settings": { "foreground": "#d4d4d8" }
        },
        {
            "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
            "settings": { "foreground": "#a1a1aa" }
        },
        {
            "scope": ["entity.name.tag", "punctuation.definition.tag"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
            "settings": { "foreground": "#facc15" }
        },
        {
            "scope": ["support.type.property-name", "support.type.property-name.json"],
            "settings": { "foreground": "#d4d4d8" }
        },
        {
            "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "meta.annotation"],
            "settings": { "foreground": "#22d3ee" }
        },
        {
            "scope": ["markup.heading", "entity.name.section"],
            "settings": { "foreground": "#fafafa", "fontStyle": "bold" }
        },
        {
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold" }
        },
        {
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic" }
        },
        {
            "scope": ["markup.underline.link", "string.other.link"],
            "settings": { "foreground": "#60a5fa" }
        },
        {
            "scope": ["markup.inserted", "meta.diff.header.to-file"],
            "settings": { "foreground": "#4ade80" }
        },
        {
            "scope": ["markup.deleted", "meta.diff.header.from-file"],
            "settings": { "foreground": "#f87171" }
        },
        {
            "scope": ["markup.changed"],
            "settings": { "foreground": "#facc15" }
        },
        {
            "scope": ["markup.quote"],
            "settings": { "foreground": "#a1a1aa", "fontStyle": "italic" }
        },
        {
            "scope": ["invalid", "invalid.illegal"],
            "settings": { "foreground": "#ef4444" }
        }
    ],
    "semanticTokenColors": {
        "namespace": "#22d3ee",
        "class": "#22d3ee",
        "type": "#22d3ee",
        "interface": "#22d3ee",
        "enum": "#22d3ee",
        "typeParameter": "#22d3ee",
        "function": "#60a5fa",
        "method": "#60a5fa",
        "decorator": "#22d3ee",
        "parameter": "#d4d4d8",
        "property": "#d4d4d8",
        "enumMember": "#facc15",
        "variable.readonly": "#facc15",
        "selfParameter": "#f87171",
        "keyword": "#c084fc"
    }
}
