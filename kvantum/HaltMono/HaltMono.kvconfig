[%General]
author=HaltOS
comment=shadcn-style monochrome theme for HaltOS
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
center_normal_tabs=false
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=6
composite=true
translucent_windows=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
menu_separator_height=9
splitter_width=5
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
transient_scrollbar=true
transient_groove=false
combo_as_lineedit=true
combo_menu=true
hide_combo_checkboxes=true
inline_spin_indicators=true
slider_width=4
slider_handle_width=16
slider_handle_length=16
check_size=16
button_icon_size=16
toolbar_icon_size=16
small_icon_size=16
large_icon_size=32
layout_spacing=6
layout_margin=10
submenu_overlap=0
dark_titlebar=true
animate_states=true
no_inactiveness=true
respect_DE=true
popup_blurring=false
menu_blur_radius=0
tooltip_blur_radius=0
click_behavior=1

[GeneralColors]
window.color=#09090b
base.color=#09090b
alt.base.color=#111113
button.color=#18181b
light.color=#3f3f46
mid.light.color=#27272a
dark.color=#000000
mid.color=#27272a
highlight.color=#27272a
inactive.highlight.color=#18181b
text.color=#fafafa
window.text.color=#fafafa
button.text.color=#fafafa
disabled.text.color=#71717a
tooltip.text.color=#18181b
highlight.text.color=#fafafa
link.color=#d4d4d8
link.visited.color=#a1a1aa
progress.indicator.text.color=#18181b

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
lxqtmainmenu_iconsize=16
blur_translucent=false
no_selection_tint=true
tint_on_mouseover=0
centered_forms=false
middle_click_scroll=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.size=12
indicator.element=arrow
text.normal.color=#fafafa
text.focus.color=#fafafa
text.press.color=#fafafa
text.toggle.color=#18181b
text.disabled.color=#71717a
text.shadow=0
text.margin=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.iconspacing=6
min_height=+6

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.toggle.color=#fafafa

[ToolboxTab]
inherits=PanelButtonTool

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow
indicator.size=12

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.toggle.color=#fafafa

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.toggle.color=#fafafa

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=4
text.margin.right=4

[ComboBox]
inherits=PanelButtonCommand
text.toggle.color=#fafafa

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=12

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
indicator.element=tab
text.normal.color=#a1a1aa
text.focus.color=#fafafa
text.press.color=#fafafa
text.toggle.color=#fafafa
text.margin.left=10
text.margin.right=10
text.margin.top=4
text.margin.bottom=4
min_height=+4

[TabFrame]
inherits=PanelButtonCommand
frame=false
interior=false

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=tree
indicator.size=12

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=#a1a1aa
text.toggle.color=#fafafa
text.bold=false

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=6
text.margin=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0
text.normal.color=#fafafa
text.bold=false

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.toggle.color=#fafafa
min_height=+4

[Splitter]
inherits=PanelButtonCommand
frame=false
interior.element=splitter
indicator.element=splitter-grip
indicator.size=16

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=0

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
indicator.element=grip
indicator.size=0

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ScrollbarGroove]
inherits=PanelButtonCommand
frame=false
interior=false

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
text.toggle.color=#fafafa

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
indicator.element=arrow
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
text.toggle.color=#fafafa
min_height=+6

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.left=8
text.margin.right=8
text.toggle.color=#fafafa

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.element=mdi
indicator.size=16
text.normal.color=#a1a1aa
text.focus.color=#fafafa
text.bold=true

[GroupBox]
inherits=GenericFrame
frame.element=group
text.margin=0
text.normal.color=#fafafa
text.bold=true

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior=true
interior.element=tooltip
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin=2
text.normal.color=#18181b

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
frame=false

[Focus]
frame=false
frame.element=focus
